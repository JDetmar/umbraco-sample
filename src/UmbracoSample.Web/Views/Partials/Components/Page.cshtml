@* Shared body for every page type: one h1, then the page's components. *@
@inherits UmbracoViewPage
@inject UmbracoSample.Web.Components.PageComponents Components
<h1>@(Model.Value<string>("title") ?? Model.Name)</h1>
@foreach (var component in Components.For(Model))
{
    @await Html.PartialAsync($"Components/{component.ViewName}", component)
}
