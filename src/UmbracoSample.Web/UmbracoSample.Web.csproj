<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="uSync" />
    <ProjectReference Include="..\UmbracoSample.ServiceDefaults\UmbracoSample.ServiceDefaults.csproj" />
    <ProjectReference Include="..\UmbracoSample.Domain\UmbracoSample.Domain.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the local appsettings.json override out of publish output -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <!-- The redirect map is read at startup from the content root (Redirects/RedirectMiddleware.cs). -->
    <Content Include="redirects.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fixture content and media are synthetic seed data for Development and CI (ES-027). uSync's package targets publish
       the whole uSync folder, so this runs afterwards and keeps the fixtures out of the publish output and the image. -->
  <Target Name="KeepFixturesOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('uSync/v17/Content/fixture-')) Or $([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('uSync/v17/Media/fixture-'))" />
    </ItemGroup>
  </Target>


</Project>
