{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true,
        "Id": "0cab52fa-ea26-4180-8607-53d804ebbb9a"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "AllowedUploadedFileExtensions": [
          "jpg",
          "jpeg",
          "png",
          "gif",
          "webp",
          "avif",
          "pdf"
        ],
        "DisallowedUploadedFileExtensions": [
          "ashx",
          "aspx",
          "ascx",
          "config",
          "cshtml",
          "vbhtml",
          "asmx",
          "air",
          "axd",
          "xamlx",
          "js",
          "mjs",
          "html",
          "htm",
          "xhtml",
          "svg",
          "svgz",
          "xml",
          "css"
        ]
      },
      "Unattended": {
        "UpgradeUnattended": false
      },
      "Runtime": {
        "Mode": "Production"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "uSync": {
    "Settings": {
      "RootFolder": "uSync/v17/",
      "ImportOnFirstBoot": true,
      "FirstBootGroup": "Settings",
      "ImportAtStartup": "Settings",
      "ExportAtStartup": "None",
      "ExportOnSave": "None",
      "BackgroundStartup": false,
      "ShowVersionCheckWarning": false
    }
  }
}
