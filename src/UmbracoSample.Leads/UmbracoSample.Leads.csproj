    "MAP", threat model 0001). The rules are in the domain; this project only does HTTP. No site-specific values: the
    host supplies the MAP address and credential through configuration.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <ProjectReference Include="..\UmbracoSample.Domain\UmbracoSample.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UmbracoSample.Leads.Tests" />
  </ItemGroup>

</Project>
