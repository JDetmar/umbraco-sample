<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contract tests for the MAP client against a WireMock.Net stub of docs/map-api.md (threat model 0001, TST-07). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="WireMock.Net.Minimal" />
    <!-- WireMock.Net.Shared asks for ASP.NET Core 2.3 packages; the shared framework replaces them (package pruning). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UmbracoSample.Leads\UmbracoSample.Leads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
