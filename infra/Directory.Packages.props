<Project>
  <!-- Infrastructure packages are pinned here, separate from the site, so the site's build never restores the large Azure provider. -->
  <Import Project="..\Directory.Packages.props" />
  <PropertyGroup>
    <!-- Pulumi 3.118.0 references OpenTelemetry 1.9.0, which has moderate advisories (NU1902). Pin the transitive packages to the patched versions the site already uses. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Pulumi" Version="3.118.0" />
    <PackageVersion Include="Pulumi.AzureNative" Version="3.30.0" />
    <PackageVersion Include="Pulumi.Command" Version="4.5.0" />
    <!-- The SQL driver the site already uses (via Umbraco), for the database user tool. Keep in step with the site. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <!-- SqlClient 6.1.6 references System.Security.Cryptography.Pkcs 9.0.11 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); pin the version the site already resolves. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
  </ItemGroup>
</Project>
